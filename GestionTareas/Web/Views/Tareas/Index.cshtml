@model Web.Tareas.Models.ListaTareasViewModel

@{
    ViewData["Title"] = "Tareas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Tareas</h1>
        <p class="text-muted mb-0">
            @Model.TotalElementos tareas encontradas
        </p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Tareas"
              asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-md-5">
                <label asp-for="Texto"
                       class="form-label">
                    Buscar
                </label>

                <input asp-for="Texto"
                       class="form-control"
                       placeholder="Título o descripción" />
            </div>

            <div class="col-md-3">
                <label asp-for="Estado"
                       class="form-label">
                    Estado
                </label>

                <select asp-for="Estado"
                        class="form-select">
                    <option value="">Todos</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="EnCurso">En curso</option>
                    <option value="Completada">Completada</option>
                </select>
            </div>

            <div class="col-md-2">
                <label asp-for="TamanoPagina"
                       class="form-label">
                    Por página
                </label>

                <select asp-for="TamanoPagina"
                        class="form-select">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </div>

            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Buscar
                    </button>

                    <a asp-controller="Tareas"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Tareas.Count == 0)
{
    <div class="alert alert-info">
        No se encontraron tareas con los filtros seleccionados.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Estado</th>
                        <th>Descripción</th>
                        <th>Creada</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var tarea in Model.Tareas)
                    {
                        var claseEstado = tarea.Estado switch
                        {
                            "Pendiente" => "bg-secondary",
                            "EnCurso" => "bg-warning text-dark",
                            "Completada" => "bg-success",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>
                                <strong>@tarea.Titulo</strong>
                            </td>

                            <td>
                                <span class="badge @claseEstado">
                                    @tarea.Estado
                                </span>
                            </td>

                            <td>
                                @(tarea.Descripcion
                                    ?? "Sin descripción")
                            </td>

                            <td class="text-nowrap">
                                @(tarea.FechaCreacion
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm"))
                            </td>

                            <td class="text-nowrap">
                                @(tarea.FechaVencimiento?
                                    .ToString("dd/MM/yyyy")
                                    ?? "Sin vencimiento")
                            </td>

                            <td class="text-end">
                                <a asp-controller="Tareas"
                                   asp-action="Detalle"
                                   asp-route-id="@tarea.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.TotalPaginas > 1)
{
    <nav class="mt-4"
         aria-label="Paginación">

        <ul class="pagination justify-content-center">
            @if (Model.Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-controller="Tareas"
                       asp-action="Index"
                       asp-route-texto="@Model.Texto"
                       asp-route-estado="@Model.Estado"
                       asp-route-pagina="1"
                       asp-route-tamanoPagina="@Model.TamanoPagina">
                        Primera
                    </a>
                </li>

                <li class="page-item">
                    <a class="page-link"
                       asp-controller="Tareas"
                       asp-action="Index"
                       asp-route-texto="@Model.Texto"
                       asp-route-estado="@Model.Estado"
                       asp-route-pagina="@(Model.Pagina - 1)"
                       asp-route-tamanoPagina="@Model.TamanoPagina">
                        Anterior
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Primera</span>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">Anterior</span>
                </li>
            }

            <li class="page-item active"
                aria-current="page">
                <span class="page-link">
                    @Model.Pagina de @Model.TotalPaginas
                </span>
            </li>

            @if (Model.Pagina < Model.TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-controller="Tareas"
                       asp-action="Index"
                       asp-route-texto="@Model.Texto"
                       asp-route-estado="@Model.Estado"
                       asp-route-pagina="@(Model.Pagina + 1)"
                       asp-route-tamanoPagina="@Model.TamanoPagina">
                        Siguiente
                    </a>
                </li>

                <li class="page-item">
                    <a class="page-link"
                       asp-controller="Tareas"
                       asp-action="Index"
                       asp-route-texto="@Model.Texto"
                       asp-route-estado="@Model.Estado"
                       asp-route-pagina="@Model.TotalPaginas"
                       asp-route-tamanoPagina="@Model.TamanoPagina">
                        Última
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente</span>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">Última</span>
                </li>
            }
        </ul>
    </nav>
}